# Estacao de visao da mesa — APSEN
# Copie para .env e ajuste. Variavel de ambiente de verdade ganha do .env.

# --- rede -------------------------------------------------------------------
# Onde esta o vision-adapter (mini PC, rede CABEADA). O IP abaixo e EXEMPLO:
# confira o da sua bancada com `ipconfig` no mini PC antes de subir.
ADAPTER_URL=http://192.168.0.10:8102

# Porta em que a estacao escuta (a mesma do vision-simulator que ela substitui)
PORTA=8202
# 0.0.0.0 = aceita conexao de outras maquinas. Com 127.0.0.1 o adapter nao
# alcanca a estacao, que e o erro mais comum nesta configuracao.
HOST=0.0.0.0

# --- regras de leitura ------------------------------------------------------
NUM_SLOTS=8
# Abaixo disto a contagem vira evento de FALHA, nunca de divergencia.
CONFIANCA_MINIMA=0.60
# Espera antes de fotografar, para as caixinhas pararem de quicar.
T_ASSENTAMENTO_S=0.5
# Teto do processamento; estourou, sai falha de timeout.
T_MAX_PROCESSAMENTO_S=20
# Quantas fotos entram no voto de maioria. Impar, para nao haver empate.
# 5 leva ~3 s nesta maquina; se o mini PC ficar perto do teto, baixe para 3.
FRAMES_POR_CAPTURA=5

# --- demonstracao -----------------------------------------------------------
# 1 reproduz o injetar_falha do simulador (contar uma a menos). Em producao
# fica 0: um campo que chega por HTTP nao pode mudar o que a camera afirma.
ACEITAR_INJECAO=0

# --- memoria do acumulado por OS -------------------------------------------
MAX_OS_MEMORIA=50
VALIDADE_OS_H=2

# --- diagnostico ------------------------------------------------------------
# Vazio = so console. Com caminho, grava tambem em arquivo.
ARQUIVO_LOG=
# ENSAIO, nao producao: repete uma foto no lugar da webcam, para testar o
# caminho HTTP com a CNC desligada. Deixe vazio na bancada.
IMAGEM_FIXA=
