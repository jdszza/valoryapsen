# ═══════════════════════════════════════════════════════════════════════════════
# APSEN — configuração local. Copie para `.env` e preencha ANTES do primeiro
# `docker compose up`. O `.env` está no .gitignore: nenhum segredo real deve
# voltar para o repositório.
#
#   cp .env.example .env
#
# ═══════════════════════════════════════════════════════════════════════════════

# ── Assinatura dos tokens JWT ────────────────────────────────────────────────
# OBRIGATÓRIO. Sem isto o central se recusa a subir (o valor antigo era público
# neste repositório — quem o tivesse forjava um token role=admin).
# Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "dev" tolera SECRET_KEY fraca, apenas com aviso no log. Qualquer outro valor
# (inclusive vazio → prod) trata segredo fraco como erro de configuração.
APSEN_ENV=prod

# ── MySQL ────────────────────────────────────────────────────────────────────
# Lidos na PRIMEIRA subida (criação do volume mysql_data). Trocar depois exige
# `docker compose down -v`, que apaga os dados.
MYSQL_ROOT_PASS=
MYSQL_USER=apsen
MYSQL_PASS=
MYSQL_DB=apsen_db

# ── Usuários seed da IHM de manutenção ───────────────────────────────────────
# Criados só na primeira inicialização do banco. TROQUE AMBAS APÓS O PRIMEIRO
# LOGIN, pela própria IHM (aba Usuários) — estas ficam em arquivo, em claro.
SEED_ADMIN_SENHA=
SEED_MANUT_SENHA=

# ── Origens de browser autorizadas a chamar o central ────────────────────────
# Ajuste para o host real ao publicar fora da máquina local.
CORS_ORIGINS=http://localhost:8050,http://localhost:8051
